---
import Layout from "../layouts/Layout.astro";
import HumanLayer from "../components/HumanLayer.astro";
import MachineLayer from "../components/MachineLayer.astro";
import ContactOverlay from "../components/ContactOverlay.astro";
import ModeToggle from "../components/ModeToggle.astro";
import { data } from "../data/content";
---

<Layout title={`${data.entity} – ${data.type}, ${data.location}`}>
  <ModeToggle slot="ui" />
  <HumanLayer />
  <MachineLayer slot="machine-layer" />
  <ContactOverlay slot="contact-overlay" />
</Layout>
