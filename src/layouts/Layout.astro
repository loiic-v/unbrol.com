---
import "../styles/global.css";

import CustomCursor from "../components/CustomCursor.astro";
import TerminalOverlay from "../components/TerminalOverlay.astro";
import { data } from "../data/content";

interface Props {
  title: string;
}

const { title } = Astro.props;

const description = `${data.entity} – ${data.identity.manifesto} ${data.type}, ${data.location}.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "UNBROL",
  alternateName: data.entity,
  url: Astro.site?.href ?? "https://unbrol.com",
  email: data.contact.email,
  foundingDate: String(data.metadata.established),
  description: data.identity.manifesto,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Brussels",
    addressCountry: "BE",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121212" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      rel="preload"
      href="/fonts/archivo-black.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script defer data-domain="unbrol.com" data-site-id="gx_zzHYNT1TTi2p" src="https://ghostlyx.com/js/script.min.js"></script>
  </head>
  <body class="relative min-h-screen overflow-x-hidden bg-graphite font-serif-human text-bone antialiased">
    <CustomCursor />

    <!--
      Global state lives in 2 checkboxes (#toggle-contact in the nav, #toggle-mode in the
      Brol-Switch). global.css reads them with html:has(...), so no JS is needed to
      open the contact overlay or flip between human and machine view.
    -->

    <!-- Persistent UI (Brol-Switch) -->
    <slot name="ui" />

    <!-- Human view -->
    <div class="layer-human relative z-10 min-h-screen bg-micro-dots">
      <slot />
    </div>

    <!-- Machine view: the same content, as the machines read it -->
    <div
      class="layer-machine fixed inset-0 z-0 overflow-auto bg-black font-mono-machine"
      aria-label="Machine view"
    >
      <slot name="machine-layer" />
    </div>

    <!-- Contact overlay -->
    <div
      class="overlay-contact fixed inset-0 z-50 border-t border-volt bg-graphite bg-micro-dots"
      role="dialog"
      aria-modal="true"
      aria-labelledby="contact-title"
    >
      <slot name="contact-overlay" />
    </div>

    <TerminalOverlay />
  </body>
</html>
