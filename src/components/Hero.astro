---
import { data } from "../data/content";

const { status, context } = data.metadata;
const { manifesto, definitions } = data.identity;
const [brol, unbrol] = definitions;

// "No Fluff. Radically Human. Machine Readable." -> one statement per line
const statements = manifesto.split(/(?<=\.)\s+/);
---

<section class="relative overflow-clip" aria-labelledby="hero-title">
  <!-- Meta rail -->
  <div
    class="flex flex-wrap items-center justify-between gap-x-2 px-5 font-mono-machine text-[10px] uppercase tracking-wider text-silver md:grid md:grid-cols-3 md:px-0 md:text-xs"
  >
    <p class="flex items-center gap-3 whitespace-nowrap py-3 md:px-12">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full bg-volt opacity-75 motion-safe:animate-ping"></span>
        <span class="relative inline-flex h-2 w-2 bg-volt"></span>
      </span>
      {status}
    </p>
    <p class="relative whitespace-nowrap py-3 text-right md:px-12 md:text-center">
      <i class="rule-y hidden md:block" aria-hidden="true"></i>
      {context}
    </p>
    <p class="relative hidden px-12 py-3 text-right md:block">
      <i class="rule-y" aria-hidden="true"></i>
      {data.location}
    </p>
  </div>
  <span class="rule" aria-hidden="true"></span>

  <!-- Headline -->
  <div class="px-5 pb-12 pt-10 md:px-12 md:pb-16 md:pt-14">
    <h1
      id="hero-title"
      class="hero-sink font-sans-heavy text-[clamp(3.25rem,13.2vw,15rem)] uppercase leading-[0.86] tracking-[-0.03em] text-bone"
    >
      <span class="reveal-line block">
        <span class="block whitespace-nowrap"
          >We unbr<span
            id="trigger-terminal"
            class="oslash cursor-help"
            title="Hold to open the terminal"
            >O<i class="slash" aria-hidden="true"></i></span
          >l</span
        >
      </span>
      <span class="reveal-line block">
        <span class="block whitespace-nowrap">The web.</span>
      </span>
    </h1>
  </div>
  <span class="rule" aria-hidden="true"></span>

  <!-- Dictionary / manifesto / CTA -->
  <div class="grid grid-cols-1 lg:grid-cols-3">
    <!-- Definitions -->
    <dl class="defs space-y-10 px-5 py-10 md:px-12 md:py-14">
      <div class="def-noun">
        <dt class="font-serif-human text-2xl font-bold italic text-bone md:text-3xl">
          {brol.term}
          <span class="ml-1 font-mono-machine text-xs font-normal not-italic text-silver">/{brol.type}</span>
        </dt>
        <dd class="mt-2 max-w-md font-serif-human text-lg leading-relaxed text-silver">
          <span class="strike">{brol.definition}</span>
        </dd>
      </div>
      <div class="def-verb cursor-help">
        <dt class="font-serif-human text-2xl font-bold italic text-bone md:text-3xl">
          {unbrol.term}
          <span class="ml-1 font-mono-machine text-xs font-normal not-italic text-silver">/{unbrol.type}</span>
        </dt>
        <dd class="mt-2 max-w-md font-serif-human text-lg leading-relaxed text-silver">
          {unbrol.definition}
        </dd>
      </div>
    </dl>

    <!-- Manifesto + CTA -->
    <div class="relative flex flex-col lg:col-span-2">
      <i class="rule-y hidden lg:block" aria-hidden="true"></i>
      <span class="rule lg:hidden" aria-hidden="true"></span>

      <p
        class="grow px-5 py-10 font-sans-heavy text-[clamp(2rem,4.6vw,4.5rem)] uppercase leading-[0.95] tracking-tight text-bone md:px-12 md:py-14"
      >
        {statements.map((s) => <span class="lit block">{s}</span>)}
      </p>

      <span class="rule" aria-hidden="true"></span>

      <label
        for="toggle-contact"
        class="group relative block cursor-pointer overflow-clip bg-volt px-5 py-8 md:px-12 md:py-10"
      >
        <span
          class="absolute inset-0 origin-left scale-x-0 bg-bone transition-transform duration-500 ease-out-expo group-hover:scale-x-100"
          aria-hidden="true"></span>
        <span class="relative font-mono-machine text-xl font-bold tracking-tight text-black md:text-2xl">
          UNBROL YOUR SITE
          <span class="inline-block transition-transform duration-300 ease-out-expo group-hover:translate-x-2" aria-hidden="true">-&gt;</span>
        </span>
      </label>
    </div>
  </div>

  <script>
    // Easter egg: hold the O for a second to open the terminal.
    const trigger = document.getElementById("trigger-terminal");
    let timer: number | undefined;

    if (trigger) {
      const startPress = (e: Event) => {
        if (e.type === "touchstart") e.preventDefault();
        trigger.classList.add("animate-pulse", "text-volt");
        timer = window.setTimeout(() => {
          document.dispatchEvent(new CustomEvent("open-terminal"));
          resetPress();
        }, 1000);
      };

      const resetPress = () => {
        if (timer) {
          clearTimeout(timer);
          timer = undefined;
        }
        trigger.classList.remove("animate-pulse", "text-volt");
      };

      trigger.addEventListener("mousedown", startPress);
      trigger.addEventListener("touchstart", startPress, { passive: false });
      trigger.addEventListener("mouseup", resetPress);
      trigger.addEventListener("mouseleave", resetPress);
      trigger.addEventListener("touchend", resetPress);
    }
  </script>
</section>
