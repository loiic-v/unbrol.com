---
import { data } from "../data/content";

// The same single source of truth, dumped raw. Tokenised at build time so the
// browser receives plain HTML, no syntax-highlighting script.
const json = JSON.stringify(data, null, 2);
const tokens = json.split(/("(?:[^"\\]|\\.)*"\s*:|"(?:[^"\\]|\\.)*"|\b(?:true|false|null)\b|-?\b\d+(?:\.\d+)?\b)/g);

const kind = (token: string) => {
  if (/^"(?:[^"\\]|\\.)*"\s*:$/.test(token)) return "key";
  if (/^"/.test(token)) return "string";
  if (/^(?:true|false|null|-?\d)/.test(token)) return "literal";
  return "plain";
};

const built = new Date().toISOString();
---

<div class="mx-auto max-w-4xl px-5 pb-24 pt-24 text-sm md:px-12 md:text-base">
  <div class="mb-8 text-xs leading-relaxed text-volt">
    // SYSTEM DUMP<br />
    // SOURCE: UNBROL_CORE<br />
    // BUILD: {built}
  </div>

  <pre class="whitespace-pre-wrap break-words leading-relaxed text-ash"><code>{
    tokens.map((token) => {
      const k = kind(token);
      if (k === "key") return <span class="text-bone">{token}</span>;
      if (k === "string") return <span class="text-silver">{token}</span>;
      if (k === "literal") return <span class="text-volt">{token}</span>;
      return token;
    })
  }</code></pre>

  <div class="mt-12 text-xs text-volt motion-safe:animate-pulse">_CURSOR_ACTIVE</div>
</div>
