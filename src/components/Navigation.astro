---

---

<header class="sticky top-0 z-40 border-b border-grid-line bg-graphite/90 backdrop-blur-sm">
  <nav
    class="flex h-nav items-center justify-between px-5 md:px-12"
    aria-label="Primary"
  >
    <!-- Logo: hover extracts the slash -->
    <a
      href="/"
      class="extract cursor-target select-none font-sans-heavy text-xl tracking-tighter text-bone md:text-2xl"
      aria-label="UNBROL, home"
    >
      <span aria-hidden="true"
        >UNBR<span class="oslash">O<i class="slash"></i></span>L</span
      >
    </a>

    <!-- Contact trigger: the checkbox that drives the overlay lives here, so it is keyboard reachable -->
    <label
      class="group flex cursor-pointer items-center gap-2 font-mono-machine text-xs uppercase tracking-widest text-bone transition-colors hover:text-volt has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-volt"
    >
      <input
        type="checkbox"
        id="toggle-contact"
        class="sr-only"
        aria-label="Contact form"
      />
      <span>Contact</span>
      <span class="contact-plus text-xl leading-none text-volt" aria-hidden="true">+</span>
    </label>
  </nav>

  <!-- Scroll progress: a volt hairline that replaces the bottom border as you read -->
  <span class="scroll-progress absolute inset-x-0 -bottom-px h-px bg-volt" aria-hidden="true"></span>
</header>
