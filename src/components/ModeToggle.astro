---
/*
  The Brol-Switch. Flips the whole page between the human view and the
  machine view (the raw data, as the machines read it). Fixed in the
  nav bar's centre so it survives the human layer fading out.
*/
---

<label
  class="brol-switch fixed left-1/2 top-0 z-50 flex h-nav -translate-x-1/2 cursor-pointer items-center"
  title="Brol-Switch: human view / machine view"
>
  <input
    type="checkbox"
    id="toggle-mode"
    class="sr-only"
    role="switch"
    aria-label="Machine view"
  />
  <span
    class="relative grid grid-cols-2 border border-grid-line bg-graphite font-mono-machine text-[10px] font-bold uppercase tracking-widest md:text-[11px]"
  >
    <span class="switch-thumb absolute inset-y-0 left-0 w-1/2" aria-hidden="true"></span>
    <span class="switch-human relative z-10 px-3 py-1.5 transition-colors duration-300">Human</span>
    <span class="switch-machine relative z-10 px-3 py-1.5 text-silver transition-colors duration-300">Machine</span>
  </span>
</label>
