---
import { data } from "../data/content";
const { email } = data.contact;
const types = ["Project", "Partnership", "Other"];
const fieldClass =
  "mt-2 block w-full border-b border-grid-line bg-transparent py-3 font-serif-human text-3xl text-bone transition-colors placeholder:text-ash focus:border-volt focus:outline-none md:text-5xl";
const labelClass = "block font-mono-machine text-xs uppercase tracking-widest text-silver";
---

<div class="flex h-full w-full flex-col overflow-y-auto">
  <!-- Header / close -->
  <div class="flex h-nav shrink-0 items-center justify-between border-b border-grid-line px-5 md:px-12">
    <h2 id="contact-title" class="font-sans-heavy text-lg uppercase tracking-tight text-bone md:text-xl">
      Send signal
    </h2>
    <label
      for="toggle-contact"
      class="cursor-pointer font-mono-machine text-xs uppercase tracking-widest transition-colors hover:text-volt"
    >
      [ Close <span aria-hidden="true">x</span> ]
    </label>
  </div>

  <div class="grid grow grid-cols-1 lg:grid-cols-3">
    <!-- Form -->
    <form
      id="signal-form"
      action="/api/submit-form"
      method="POST"
      class="space-y-14 px-5 py-10 md:px-12 md:py-16 lg:col-span-2 lg:px-24"
    >
      <fieldset class="space-y-5">
        <legend class={labelClass}>Signal type</legend>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {
            types.map((type) => (
              <label class="group flex cursor-pointer items-center gap-3">
                <input
                  type="checkbox"
                  name="interest"
                  value={type.toLowerCase()}
                  class="h-5 w-5 appearance-none border border-silver transition-colors checked:border-volt checked:bg-volt"
                />
                <span class="font-serif-human text-xl text-silver transition-colors group-hover:text-bone">{type}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="space-y-10">
        <div>
          <label for="f-company" class={labelClass}>Company / Entity</label>
          <input id="f-company" name="company" type="text" required autocomplete="organization" class={fieldClass} />
        </div>
        <div>
          <label for="f-email" class={labelClass}>Email frequency</label>
          <input id="f-email" name="email" type="email" required autocomplete="email" inputmode="email" class={fieldClass} />
        </div>
        <div>
          <label for="f-message" class={labelClass}>Transmission</label>
          <textarea id="f-message" name="message" rows="2" class={`${fieldClass} resize-none`}></textarea>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-6 pt-2">
        <button
          type="submit"
          class="cursor-pointer bg-volt px-10 py-4 font-sans-heavy text-lg uppercase tracking-tight text-black transition-colors hover:bg-bone disabled:opacity-60 md:text-xl"
        >
          Initiate link
        </button>
        <p id="signal-status" class="font-mono-machine text-xs uppercase tracking-widest text-silver" role="status" aria-live="polite"></p>
      </div>
    </form>

    <!-- Coordinates -->
    <aside class="relative space-y-10 px-5 py-10 md:px-12 md:py-16">
      <i class="rule-y hidden lg:block" aria-hidden="true"></i>
      <span class="rule lg:hidden" aria-hidden="true"></span>
      <div>
        <h3 class={`${labelClass} mb-3`}>Coordinates</h3>
        <p class="font-serif-human text-xl text-bone">
          {data.contact.address}<br />
          (GMT+1)
        </p>
      </div>
      <div>
        <h3 class={`${labelClass} mb-3`}>Frequency</h3>
        <a href={`mailto:${email}`} class="font-serif-human text-xl text-bone transition-colors hover:text-volt">
          {email}
        </a>
      </div>
      <div>
        <h3 class={`${labelClass} mb-3`}>Legal</h3>
        <p class="font-serif-human text-base text-silver">
          BE 0000.000.000<br />
          Privacy Policy
        </p>
      </div>
    </aside>
  </div>
</div>

<script>
  // Progressive enhancement. Without JS the overlay still opens (CSS state) and the
  // form still posts to the function. With JS: Escape closes, focus moves into the
  // form, the page behind is inert, and the answer is shown inline.
  const toggle = document.getElementById("toggle-contact") as HTMLInputElement | null;
  const behind = document.querySelectorAll<HTMLElement>(".layer-human main, .layer-human footer");
  const form = document.getElementById("signal-form") as HTMLFormElement | null;
  const status = document.getElementById("signal-status");
  const firstField = document.getElementById("f-company") as HTMLInputElement | null;

  const sync = () => {
    const open = Boolean(toggle?.checked);
    behind.forEach((el) => (el.inert = open));
    if (open) window.setTimeout(() => firstField?.focus({ preventScroll: true }), 400);
  };

  toggle?.addEventListener("change", sync);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.checked) {
      toggle.checked = false;
      sync();
      toggle.focus();
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const say = (text: string) => {
      if (status) status.textContent = text;
    };

    if (button) button.disabled = true;
    say("Transmitting...");

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const json = await res.json();
      if (!res.ok || json.status !== "SIGNAL_RECEIVED") throw new Error(json.message);
      form.reset();
      say("Signal received. We will unbrol your request shortly.");
    } catch {
      say("Signal lost. Retry, or write to hello@unbrol.com.");
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
